import helpers from "../database.cjs";
export class LlamaCpp {
  constructor({ embedModel }) { this.model = embedModel; helpers.event("llm", { model: embedModel, parallelism: process.env.QMD_EMBED_PARALLELISM || "automatic" }); }
  get embedModelName() { return this.model; }
  async resolveModel() { throw new Error("implicit model resolution/download forbidden in fixture"); }
  async ensureLlama(allowBuild) {
    if (allowBuild !== false) throw new Error("native downloads/builds forbidden in fixture");
    helpers.event("native", { allowBuild });
    return { gpu: false };
  }
  isCpuOffloadForced() { return false; }
  async computeParallelism() { return 1; }
  // Query embedding for the warm smart-search worker; same guards as indexing.
  async embedBatch(texts) {
    await this.resolveModel(this.model);
    await this.ensureLlama();
    await this.computeParallelism(150, 0);
    helpers.event("embed-query", { count: texts.length });
    return texts.map(() => ({ embedding: [1, 0, 0], model: this.model }));
  }
  async dispose() { helpers.fail("dispose"); }
}
let singleton;
export function setDefaultLlamaCpp(value) { singleton = value; }
export function getDefaultLlamaCpp() { return singleton; }
export function resolveModels(config) {
  return { embed: config?.embed || process.env.QMD_EMBED_MODEL || "fixture-default-embed",
    generate: config?.generate || "fixture-default-generate", rerank: config?.rerank || "fixture-default-rerank" };
}
export async function withLLMSession(fn) { return await fn(); }
export function formatQueryForEmbedding(query) { return query; }
