+// Keep the broad lexical guard unchanged. Natural question wording is not QMD
+// exclusion syntax, but vectors still cannot enforce exact phrases or IDs.
+export function hasSemanticQueryConstraints(value: string): boolean {
+  if (!hasQueryConstraints(value)) return false;
+  if (/[\r\n]/.test(value)
+    || !/^\s*(?:what|why|how|when|where|who|which|can|could|should|would|did|does|do|is|are|was|were|has|have)\b/i.test(value)
+    || (value.match(/[a-z]+/gi)?.length ?? 0) < 3) return true;
+  // Normalize only the eligibility probe, never either executed query. Explicit
+  // uppercase Boolean/exclusion spelling, boundary -terms, paths, camelCase,
+  // mixed alphanumeric IDs and ticket/version punctuation remain protected.
+  const probe = value
+    .replace(/\b[a-z]+['’](?:t|s|re|ve|ll|d|m)\b/gi, token => token.replace(/['’]/, ""))
+    .replace(/\b(?:not|no|without|except|exclude|excluding)\b/g, " ")
+    .replace(/\b[a-z]+(?:-[a-z]+)+\b/g, token => token.replace(/-/g, " "));
+  return hasQueryConstraints(probe);
+}
