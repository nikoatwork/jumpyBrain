# Copy to .env.local. Private eval configuration, never product configuration.
JB_EVAL_NODE=/absolute/path/to/node
JB_EVAL_CLI=/absolute/path/to/runtime/dist/cli.js
JB_EVAL_APP=/absolute/path/to/jumpyBrain.app
JB_EVAL_QMD=/absolute/path/to/qmd
JB_EVAL_LOCAL_ROOT=/absolute/path/to/brain
JB_EVAL_LOCAL_PROFILE=local-profile-id
JB_EVAL_LOCAL_LANE=shared-synthetic
JB_EVAL_VPS_URL=https://brain.example
JB_EVAL_VPS_PROFILE=remote-profile-id
JB_EVAL_VPS_LANE=shared-synthetic
# Existing private file containing JUMPYBRAIN_API_KEY; parsed as data, never sourced.
JB_EVAL_REMOTE_ENV=/absolute/path/to/private/remote.env
# Record authorization actually supplied by the owner. These fields cannot grant it.
JB_EVAL_AUTHORIZATION=
JB_EVAL_ALLOW_MUTATIONS=
# Comma-separated target aliases, e.g. local,vps, only after owner authorization.
